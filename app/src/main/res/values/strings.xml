    <string name="section_about">About</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_privacy">Unlock collects no personal data, shows no ads and never sends any links or article content. Anonymous usage data (TelemetryDeck) can be turned off anytime under Privacy. To find updates, Unlock asks GitHub about once a day for the latest version – no personal data is sent.</string>
    <string name="about_archive">archive.today and the Wayback Machine are independent third-party services. They may show captchas, change domains or be temporarily unavailable.</string>
