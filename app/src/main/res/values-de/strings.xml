    <string name="about_version">Version %1$s</string>
    <string name="about_privacy">Unlock sammelt keine persönlichen Daten, keine Werbung und sendet niemals gelesene Links oder Artikelinhalte. Optionale anonyme Nutzungsstatistiken (TelemetryDeck) lassen sich oben jederzeit abschalten.</string>
