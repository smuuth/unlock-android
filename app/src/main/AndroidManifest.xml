<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet-Berechtigung ausschließlich zum Laden archivierter Artikel im integrierten Lesemodus. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <queries>
        <!-- Custom-Tabs-Anbieter und Browser finden (Package Visibility, Android 11+). -->
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".UnlockApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Unlock"
        tools:targetApi="37">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Unsichtbares Share-Ziel: kein Fenster, kein Verlauf, nicht in „Zuletzt verwendet“. -->
        <activity
            android:name=".share.ShareActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/share_label"
            android:noHistory="true"
            android:taskAffinity="dev.unlock.share"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Launcher-Shortcuts: liest die Zwischenablage (benötigt kurz Fensterfokus). -->
        <activity
            android:name=".share.ClipboardActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="dev.unlock.share"
            android:theme="@style/Theme.Unlock.Invisible" />

        <!-- Löst Google-Kurzlinks (share.google, search.app) im Hintergrund auf. -->
        <activity
            android:name=".share.ShortLinkActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="dev.unlock.share"
            android:theme="@style/Theme.Unlock.Invisible" />

        <!-- Einstellungen (Unterseite der Startseite). -->
        <activity
            android:name=".settings.SettingsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!-- Lokale Statistik (Unterseite der Startseite). -->
        <activity
            android:name=".stats.StatsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!-- Integrierte Leseansicht für archivierte Artikel. -->
        <activity
            android:name=".reader.ReaderActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize" />
    </application>
</manifest>
